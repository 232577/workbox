{
  "name": "workbox-downloads",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/download/*", "/healthz"]
  },
  "routes": [
    { "pattern": "workbox.ltxiangzi.dpdns.org", "custom_domain": true }
  ]
}
