{
  "name": "workbox-downloads",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/download/*", "/media/*", "/healthz", "/api/*", "/stats", "/stats/"]
  },
  "durable_objects": {
    "bindings": [{"name":"METRICS", "class_name":"SiteMetrics"}]
  },
  "migrations": [{"tag":"v1-metrics", "new_sqlite_classes":["SiteMetrics"]}],
  "routes": [
    { "pattern": "workbox.ltxiangzi.dpdns.org", "custom_domain": true }
  ]
}
